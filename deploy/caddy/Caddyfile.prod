# IDRE platform edge — PRODUCTION. TLS + HSTS + security headers.
#
# Required environment:
#   DOMAIN      public hostname (e.g. idre.example.gov) — no default
#   ACME_EMAIL  contact for certificate expiry notices
#
# Usage: mount this file over /etc/caddy/Caddyfile (compose override or k8s
# ConfigMap) instead of the development Caddyfile, which serves plain HTTP on
# :80 and intentionally omits HSTS.

(security_headers) {
	header {
		# clickjacking / MIME / referrer hygiene for a government-workflow PWA
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(self), geolocation=()"
		# PWA needs inline handlers today; tighten nonces when the portal is refactored
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self'; manifest-src 'self'"
		# HSTS: two years, subdomains, preload-eligible. HTTPS-only by design.
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		-Server
	}
}

{$DOMAIN} {
	tls {$ACME_EMAIL}
	import security_headers

	# Identity — canonical public issuer path. Keycloak is started with
	# KC_HTTP_RELATIVE_PATH=/auth so every realm URL (discovery, JWKS, token)
	# is /auth/realms/... both through this proxy and inside the network.
	handle_path /auth/* {
		reverse_proxy keycloak:8080
	}

	# API traffic — APISIX keeps its policy plugins; Caddy adds nothing but
	# transport. /internal/* (vault east-west) is never forwarded.
	handle /internal/* {
		respond "not found" 404
	}
	handle /v1/* {
		reverse_proxy apisix:9080
	}
	handle /api/* {
		reverse_proxy apisix:9080
	}
	handle /ml/* {
		reverse_proxy apisix:9080
	}

	# Portal PWA — static files with SPA fallback; the service worker must
	# always revalidate or stale app shells survive deploys.
	handle {
		root * /srv/portal
		@sw path /sw.js
		header @sw Cache-Control "no-cache"
		@immutable path /assets/* /icons/*
		header @immutable Cache-Control "public, max-age=604800, immutable"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}

# Internal TLS: Caddy's local CA can also issue east-west certificates
# (tls internal) if the platform moves vault/worker traffic to HTTPS.
