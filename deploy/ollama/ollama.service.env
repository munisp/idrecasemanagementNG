# Ollama runtime tuning for the IDRE copilot host.
# Install: /etc/systemd/system/ollama.service.d/override.conf  ->
#   [Service]
#   EnvironmentFile=/etc/idre/ollama.service.env
# Then: systemctl daemon-reload && systemctl restart ollama

# --- Determinism -------------------------------------------------------------
# SINGLE-STREAM SERVING. Batched/concurrent inference is not bit-identical
# across load shapes (kernel reductions reorder floats). With NUM_PARALLEL=1
# + temperature 0 + pinned quantization, the same request replays byte-for-
# byte — which the eval harness asserts. Throughput is NOT a real concern
# here: the platform makes ONE bounded call per human action, so peak demand
# is a handful of concurrent workers.
OLLAMA_NUM_PARALLEL=1

# --- Performance -------------------------------------------------------------
# Keep the model resident: first-token latency drops from ~10s (cold load)
# to sub-second. -1 = never unload; use 24h if the host shares VRAM.
OLLAMA_KEEP_ALIVE=-1
# One model, always loaded — this host exists to serve the copilot.
OLLAMA_MAX_LOADED_MODELS=1
# Flash attention: measurably faster at 8k context. SAFE here because it is
# pinned ON for every request; never toggle after the eval baseline is taken
# (numerics shift slightly -> outputs shift slightly).
OLLAMA_FLASH_ATTENTION=1
# KV cache quantization: q8_0 halves context memory at negligible quality
# cost. Pin it, like everything else. Use f16 if you want maximum fidelity
# and have VRAM headroom.
OLLAMA_KV_CACHE_TYPE=q8_0

# --- Capacity ----------------------------------------------------------------
# Queue depth for burst moments (morning briefing hour). Requests beyond
# this wait rather than error; the platform's 90s client timeout absorbs it.
OLLAMA_MAX_QUEUE=32
# CPU fallback threads (only used if layers spill off GPU). Set to physical
# cores; oversubscription HURTS. On a CPU-only host this is THE latency knob:
# measure with services/llm/bench_ollama.py at physical cores and at
# physical-cores/2 (memory bandwidth saturation often makes fewer faster).
# OLLAMA_NUM_THREAD=16
